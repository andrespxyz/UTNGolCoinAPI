<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="UTNGolCoinPU" transaction-type="JTA">
        <jta-data-source>java:/MySqlDS</jta-data-source>
        <class>ec.utn.gol.models.Billetera</class>
        <class>ec.utn.gol.models.Transaccion</class>
        <class>ec.utn.gol.models.Prediccion</class>
        <class>ec.utn.gol.models.BonoDiario</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>